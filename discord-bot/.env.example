# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Your Discord bot token (get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_token_here

# Comma-separated list of Discord channel IDs to monitor
# Right-click a channel → Copy Channel ID (enable Developer Mode in Discord settings)
NEWS_CHANNEL_IDS=123456789012345678,987654321098765432

# (Optional) Webhook URL to forward messages to
# Leave empty if not using webhooks
WEBHOOK_URL=

# Where to save the JSON file (relative to this directory)
# Default: saves to the website's public folder for easy access
OUTPUT_FILE=../public/news-live.json
